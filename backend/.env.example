# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
BACKEND_URL=http://localhost:5000

# ========================================
# DATABASE
# ========================================
MONGO_URI=mongodb://localhost:27017/car-rental
MONGODB_URI=mongodb://localhost:27017/car-rental
# Or MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/car-rental

# ========================================
# JWT TOKENS
# ========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d
JWT_EXPIRE=7d

# ========================================
# EMAIL SERVICE (Gmail, SendGrid, AWS SES, or Ethereal)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
FROM_EMAIL=noreply@apnaride.com

# For development testing (Ethereal fake SMTP)
ETHEREAL_USER=your-ethereal-username
ETHEREAL_PASS=your-ethereal-password

# ========================================
# SMS/OTP SERVICE - TWILIO
# ========================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# ========================================
# GOOGLE OAUTH (https://console.cloud.google.com)
# ========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# GITHUB OAUTH (https://github.com/settings/developers)
# ========================================
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ========================================
# FACEBOOK OAUTH (https://developers.facebook.com/apps)
# ========================================
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ========================================
# CLOUDINARY (for avatar uploads)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
